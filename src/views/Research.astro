---
import Site from '../layouts/Site.astro';
import { language } from '../lib/locale.js';
import { googleScholar } from '../lib/profile.js';

const { english, t } = language(Astro.url.pathname);
const description = english
  ? 'Berry’s research interests in zero-knowledge proofs and verifiable computation, and a link to publications.'
  : 'Berry 的研究兴趣包括零知识证明和可验证计算。可通过 Google 学术查看论文。';
---
<Site title={t.research} description={description}>
  <header class="page-head"><h1>{t.research}</h1></header>
  <div class="research-sections">
    <section aria-labelledby="research-interests">
      <h2 id="research-interests">{english ? 'Research interests' : '研究兴趣'}</h2>
      <p>{english
        ? 'I’m interested in zero-knowledge proofs and verifiable computation, especially how succinct proof systems represent computations as arithmetic circuits, constraints, and polynomials.'
        : '我关注零知识证明和可验证计算，尤其是简洁证明系统如何用算术电路、约束和多项式表示计算。'}</p>
    </section>
    <section aria-labelledby="publications">
      <h2 id="publications">{english ? 'Publications' : '论文'}</h2>
      <p><a href={googleScholar}>{english ? 'View publications on Google Scholar' : '在 Google 学术上查看论文'}</a></p>
    </section>
  </div>
</Site>
