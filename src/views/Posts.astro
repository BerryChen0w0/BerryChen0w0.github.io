---
import Site from '../layouts/Site.astro';
import PostList from '../components/PostList.astro';
import { language } from '../lib/locale.js';
import { published } from '../lib/content.js';
const { t } = language(Astro.url.pathname);
---
<Site title={t.allPosts}>
  <div class="page-head"><h1>{t.allPosts}</h1></div>
  <PostList posts={published} />
</Site>
